# ============================================================================
# MAINTeX — configuration du serveur
# Sur Cloud Run, les valeurs secrètes viennent de Secret Manager.
# ============================================================================

# --- Connexion Google (un seul login pour toute la plateforme) --------------
# ID client OAuth « Application Web » (Console Google Cloud > API et services > Identifiants).
MAINTEX_GOOGLE_CLIENT_ID=
# Secret de signature de la session : 32 caractères au moins (openssl rand -base64 48).
MAINTEX_SESSION_SECRET=
# Domaine Google Workspace de l'entreprise : seuls ses comptes peuvent se connecter.
MAINTEX_WORKSPACE_DOMAIN=aperam.com
# Administrateurs d'amorçage : accès garanti à la zone Admin, même sans fiche.
# À réduire à des comptes de l'entreprise lors du transfert vers l'environnement Aperam.
MAINTEX_BOOTSTRAP_ADMINS=
# Adresses hors domaine autorisées à titre exceptionnel (séparées par des virgules).
MAINTEX_EXTRA_EMAILS=

# --- Adresse publique de MAINTeX --------------------------------------------
# Sert d'émetteur (« iss ») des jetons transmis aux applications.
MAINTEX_PUBLIC_URL=https://maintex-xxxxx-ew.a.run.app

# --- Jetons pour les applications (connexion unique) ------------------------
# Clé privée RSA au format PEM (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048).
# Sans elle, en production, les applications gardent leur propre login.
MAINTEX_SIGNING_KEY=

# --- Adresses des applications ----------------------------------------------
# JSON : identifiant d'application → adresse https. Modifiable sans reconstruire MAINTeX.
MAINTEX_APP_URLS={"5s":"https://...","alphap":"https://...","meetings":"https://meeting-management-qbxmdrfhnq-ew.a.run.app"}

# --- Stockage des utilisateurs, rôles et du journal -------------------------
# firestore (défaut sur Cloud Run) | file (défaut ailleurs) | memory (tests)
MAINTEX_STORE=
# Projet et base Firestore (par défaut : le projet du service Cloud Run, base « (default) »).
MAINTEX_FIRESTORE_PROJECT=
MAINTEX_FIRESTORE_DATABASE=
# Fichier utilisé quand MAINTEX_STORE=file.
MAINTEX_DATA_FILE=./data/maintex-access.json

# --- Anciennes variables (reprises automatiquement au premier démarrage) ----
# MAINTEX_USERS_JSON=[...]   → importé une seule fois comme fiches utilisateurs
# MAINTEX_EXTRA_EMAIL=...    → équivalent de MAINTEX_EXTRA_EMAILS
# VITE_5S_APP_URL / VITE_ALPHAP_APP_URL → utilisées si MAINTEX_APP_URLS ne les donne pas

# --- Développement local ----------------------------------------------------
# npm run dev:server (API sur le port 3001) + npm run dev (interface sur le port 3000)
# MAINTEX_INSECURE_COOKIES=true   (uniquement en http local)
